{
  "name": "chzzkchatconplus",
  "version": "0.4.2",
  "description": "ChzzkChatConPlus - 치지직 채팅의 명령어를 이미지로, BBCode를 꾸민 글자로 바꿔 OBS에 보여 주는 오버레이",
  "main": "src/main/index.js",
  "author": "ChzzkChatConPlus contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron . --no-sandbox",
    "server": "node src/server/cli.js",
    "test": "node --test \"test/*.test.js\"",
    "dist:win": "electron-builder --win --x64"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^24.1.3"
  },
  "build": {
    "appId": "app.chzzkchatconplus",
    "productName": "ChzzkChatConPlus",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "ChzzkChatConPlus-${version}-portable.exe"
    },
    "electronLanguages": [
      "ko",
      "en-US"
    ]
  }
}
